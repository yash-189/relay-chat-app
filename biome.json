{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/features/*/*"],
                "message": "Import another feature through its index.ts (@/features/<name>), not its internals."
              }
            ],
            "paths": {
              "sonner": "Import toast from @/lib/toast so the library stays swappable."
            }
          }
        },
        "noNestedTernary": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "functions": ["cn", "cva"]
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/ui/**", "src/lib/**", "src/shared/**", "src/theme/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "@/providers/**",
                      "@/app/**",
                      "@/store/**"
                    ],
                    "message": "ui/, lib/ and shared/ sit below features and must not import them or the store."
                  }
                ],
                "paths": {
                  "sonner": "Import toast from @/lib/toast so the library stays swappable."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/mocks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**"],
                    "message": "src/mocks sits below features and must not import them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/primitives/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          },
          "style": {
            "noNestedTernary": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "nursery": {
            "useSortedClasses": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/toast.ts", "src/ui/primitives/sonner.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
